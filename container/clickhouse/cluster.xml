<clickhouse>
    <!--
      Single-node "cluster" definition — required because SigNoz's schema
      migrator issues `ON CLUSTER '{cluster}'` DDL even for a one-node
      ClickHouse (see SIGNOZ_OTEL_COLLECTOR_CLICKHOUSE_CLUSTER in
      otel-collector-config.yaml, which must name THIS cluster). Ported from
      SigNoz's own self-host docker-compose reference config, trimmed to one
      shard / one replica since this app runs one ClickHouse per workspace,
      not a multi-node deployment.

      The <zookeeper> block is NOT optional even for one node — confirmed
      live: without it ClickHouse rejects SigNoz's ReplicatedMergeTree DDL
      with "code: 139, message: There is no Zookeeper configuration in
      server config" and the otelcol migration retries forever. Points at
      this app's own zookeeper sidecar by its framework-assigned DNS name
      (aw-app-<id>-<sidecar-name>).
    -->
    <remote_servers>
        <cluster>
            <shard>
                <replica>
                    <host>localhost</host>
                    <port>9000</port>
                </replica>
            </shard>
        </cluster>
    </remote_servers>
    <zookeeper>
        <node>
            <host>aw-app-signoz-zookeeper</host>
            <port>2181</port>
        </node>
    </zookeeper>
    <distributed_ddl>
        <path>/clickhouse/task_queue/ddl</path>
    </distributed_ddl>
    <!--
      SigNoz's ReplicatedMergeTree table paths (e.g.
      /clickhouse/tables/{uuid}/{shard}) reference these macros — confirmed
      live: without them ClickHouse rejects every CREATE TABLE with "No
      macro 'shard' in config". One shard, one replica, since this is a
      single-node-per-workspace deployment, not a multi-node cluster.
    -->
    <macros>
        <shard>01</shard>
        <replica>01</replica>
    </macros>
</clickhouse>
